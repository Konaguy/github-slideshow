{
  "system": "CyberShield Analytics",
  "version": "1.0.0",
  "description": "Multi-agent cybersecurity orchestration system. Import this file into any bot framework, LangChain, CrewAI, AutoGen, or Claude API integration. Each agent block contains a complete system prompt path, tool list, trigger conditions, and escalation routing.",
  "coordinator": "sarge",

  "threat_level_logic": {
    "GREEN": "No P1 or P2 findings open. All agents nominal.",
    "YELLOW": "1-2 P2 findings open. No active exploitation confirmed.",
    "ORANGE": "1+ P1 findings open. Or: active threat indicator with unpatched critical CVE.",
    "RED": "Active incident declared. Confirmed breach indicator. IncidentBot activated."
  },

