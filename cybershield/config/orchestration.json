  "data_flows": {
    "vulnscan_to_ironclad": "All P1/P2 findings with full CVE context",
    "vulnscan_to_sarge": "Weekly summary + all P1 immediate alerts",
    "netwatch_to_sarge": "All P1 immediate + P2 within 1 hour",
    "netwatch_to_darkeye": "Unknown external IPs for IOC enrichment",
    "ironclad_to_sarge": "DLP alerts + remediation completion confirmations",
    "ironclad_to_patchmaster": "Approved patch deployment requests",
    "complybot_to_sarge": "Daily scorecard + drift alerts",
    "patchmaster_to_sarge": "Weekly status + emergency tier1 completion",
    "certsentry_to_sarge": "Expiry alerts per threshold",
    "cloudguard_to_sarge": "All findings per severity",
    "incidentbot_to_sarge": "Real-time incident status",
    "incidentbot_to_ironclad": "Containment orders",
    "incidentbot_to_idguard": "Account disable orders",
    "darkeye_to_netwatch": "IOC blocklist updates",
    "darkeye_to_idguard": "Credential exposure notifications",
    "darkeye_to_sarge": "Daily intel brief + P1 alerts",
    "idguard_to_sarge": "All anomaly alerts per severity"
  },

  "import_instructions": {
    "claude_code": {
      "steps": [
        "Place cybershield/ directory in your project root",
        "Claude Code auto-loads CLAUDE.md — system is immediately active",
        "Invoke agents with @AgentName prefix in your message",
        "Each agent's system_prompt_file is the context to load"
      ]
    },
    "claude_api": {
      "steps": [
        "Load system_prompt_file content as the 'system' parameter in your API call",
        "Set model per model_recommended field in each agent block",
        "Use tool definitions from agent-tools.json",
        "Chain agents by routing outputs per data_flows above"
      ],
      "example_code": "See /cybershield/config/api-integration-example.py"
    },
    "crewai": {
      "steps": [
        "Map each agent block to a CrewAI Agent() object",
        "system_prompt_file content → Agent(backstory=...)",
        "tools list → Agent(tools=[...])",
        "escalation_path → Task routing",
        "triggers → Task conditions"
      ]
    },
    "autogen": {
      "steps": [
        "Map each agent to an AssistantAgent with system_message from system_prompt_file",
        "Sarge = UserProxyAgent with human_input_mode='NEVER'",
        "Use GroupChat with sarge as manager",
        "trigger_conditions map to tool call routing"
      ]
    },
    "langchain": {
      "steps": [
        "Each agent = LangChain Agent with system prompt from system_prompt_file",
        "tools list maps to LangChain Tool objects",
        "Orchestration via LangGraph with sarge as supervisor node",
        "data_flows map to LangGraph edges"
      ]
    },
    "sagemaker": {
      "steps": [
        "See /cybershield/sagemaker/pipeline.yaml for ML component definitions",
        "Deploy anomaly-detection, threat-classification, and behavioral-analysis endpoints",
        "Integrate inference endpoint URLs into netwatch and idguard tool configurations",
        "Use EventBridge scheduled rules for trigger_conditions marked as 'scheduled_*'"
      ]
    }
  }
}
