# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-something-random-and-long

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default)
DATABASE_URL=sqlite:///omnimanager.db

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/omnimanager

# ─── Admin account (created on first run) ─────────────────────────────────────
ADMIN_PASSWORD=admin

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ─── SocketIO ─────────────────────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=threading

# ─── WinRM defaults ───────────────────────────────────────────────────────────
WINRM_PORT=5985
WINRM_TRANSPORT=ntlm
WINRM_TIMEOUT=30

# ─── RDP ──────────────────────────────────────────────────────────────────────
RDP_PORT=3389
